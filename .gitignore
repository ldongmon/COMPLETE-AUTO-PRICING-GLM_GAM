# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# --- Data (never commit raw/processed data: re-fetched via src/data/load_data.py) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Exception: the Streamlit app (app/utils.py) reads this file directly, and Streamlit Cloud
# only clones the repo: it never runs notebook 01 to regenerate it. 8.1MB, committed deliberately
# so the deployed app works without a manual data-prep step. See reports/model_cards/streamlit_app.md. ---
!data/processed/policy_level_clean.parquet

# --- Trained model artifacts (regenerated by notebooks: large binary files don't belong in git) ---
models/*.pkl
models/*.joblib
models/*.gam

# --- Exception: models/app/ holds the Phase 12 *distilled* artifacts (src/models/lightweight_glm.py,
# scripts/distill_app_models.py): a few KB each, committed deliberately so the Streamlit app is
# deployable straight from the repo without needing to re-run the full training notebooks. ---
!models/app/
!models/app/*.pkl
!models/app/*.joblib

# --- Test / kernel artifacts ---
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Env / secrets ---
.env

# --- Private, local-only files: never pushed, kept out of the public repo on purpose ---
AUTO_PRICING_REPORT_FR.pdf
LIVRE_PEDAGOGIQUE_PROJET.pdf

# --- Private reports (sources and PDFs), kept out of the public repo ---
private_reports/
AUTO_PRICING_REPORT.pdf
